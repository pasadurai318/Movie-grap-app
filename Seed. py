def seed():
    driver = GraphDatabase.driver(URI, auth=(USERNAME, PASSWORD))
    with driver.session() as session:
        print("Clearing existing data...")
        session.run("MATCH (n) DETACH DELETE n")
        print("Creating movies...")
        for m in movies:
            session.run("CREATE (m:Movie {title: $title, year: $year, genre: $genre, rating: $rating})",
                title=m["title"], year=m["year"], genre=m["genre"], rating=m["rating"])
        print("Creating actors and relationships...")
        for a in actors:
            session.run("MERGE (a:Actor {name: $name})", name=a["name"])
            for movie_title in a["movies"]:
                session.run("MATCH (a:Actor {name: $name}) MATCH (m:Movie {title: $title}) MERGE (a)-[:ACTED_IN]->(m)",
                    name=a["name"], title=movie_title)
        print("Done!")
    driver.close()

if __name__ == "__main__":
    seed()
